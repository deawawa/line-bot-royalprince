# ── LINE Messaging API ────────────────────────────────────────────────
# From LINE Developers Console > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── AI Provider (switchable, no business-logic change needed) ─────────
# AI_PROVIDER: "anthropic" | "openai"
AI_PROVIDER=anthropic
# Model id for the chosen provider, e.g. claude-sonnet-4-5 / gpt-4o-mini
AI_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional generic key (used if provider-specific key is missing)
AI_API_KEY=

# ── Database (Supabase PostgreSQL) ────────────────────────────────────
# Use the "Transaction" pooler URL (port 6543) for serverless/Vercel
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Admin ─────────────────────────────────────────────────────────────
# Long random string used to sign admin session JWT
ADMIN_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron protection (Vercel Cron sends this as Bearer token) ──────────
CRON_SECRET=
